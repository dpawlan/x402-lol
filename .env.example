# ── Database (required in production; auto-set by the Vercel Neon integration)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── x402 payments
# Wallet that receives bid payments. Required in production (bids are refused without it).
X402_PAY_TO_ADDRESS=0xYourWalletAddress
# CAIP-2 network. Base mainnet = eip155:8453, Base Sepolia (testnet) = eip155:84532
X402_NETWORK=eip155:8453

# Facilitator. The public x402.org facilitator only settles TESTNET (eip155:84532).
# For Base mainnet use the Coinbase CDP facilitator: create an API key at
# https://portal.cdp.coinbase.com and set both values below (URL is inferred).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional override (defaults to CDP when keys are set, otherwise x402.org)
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Public URL used in the 402 resource descriptor
NEXT_PUBLIC_SITE_URL=https://x402.lol

# ── Dev / ops toggles
# X402_MOCK=true        # skip payments entirely (never in production)
# SEED_DEMO_DATA=true   # insert fake demo listings into an empty DB

# Shown in openapi.json info.contact.email (lets you verify origin ownership on x402scan/Poncho)
CONTACT_EMAIL=you@example.com
